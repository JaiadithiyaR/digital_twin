        <mxCell id="n66" value="ContinuousOrchestrator — src/main.py&#10;(Thread 1: telemetry sync, never blocked · Thread 2: trigger + adaptation cycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8A8A8A;dashed=1;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#5A5A5A;spacing=6;arcSize=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="48" y="516" width="1584" height="1954.0" as="geometry"/></mxCell><mxCell id="t1" value="AI-DRIVEN SELF-ADAPTIVE NETWORK DIGITAL TWIN" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="t2" value="System Architecture and Continuous Adaptation Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1310" y="78" width="330" height="136" as="geometry"/></mxCell><mxCell id="t4" value="LEGEND" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1318" y="80" width="314" height="16" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#2E5C8A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1320" y="102" width="16" height="16" as="geometry"/></mxCell><mxCell id="t6" value="Ingestion / transport" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=8.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1342" y="99" width="130" height="22" as="geometry"/></mxCell><mxCell id="n7