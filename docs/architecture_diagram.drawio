=#FCE4E4;strokeColor=#B23A3A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="166" width="16" height="16" as="geometry"/></mxCell><mxCell id="t16" value="Deterministic decision gate" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=8.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1502" y="163" width="130" height="22" as="geometry"/></mxCell><mxCell id="t17" value="&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT n&lt;/span&gt;&amp;nbsp; = one of the six official adaptation agents" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=8.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1320" y="194" width="310" height="16" as="geometry"/></mxCell><mxCell id="band18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="1600" height="110" as="geometry"/></mxCell><mxCell id="bandlbl19" value="SOURCE" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="211.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b style='font-size:13px'&gt;Module 1 — NS-3 / 5G-LENA Network Simulator&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;ns3_sim/nr_5g_telemetry_sim.cc&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;real 3GPP-modeled gNB/UE telemetry — SOURCE=NS3_5G_LENA&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A5568;strokeColor=#1A202C;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="660.0" y="245.0" width="420" height="72" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b style='font-size:10px'&gt;Mock Telemetry&lt;br&gt;(dev/demo)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;mock_source.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6B7280;strokeColor=#1A202C;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="245.0" width="190" height="72" as="geometry"/></mxCell><mxCell id="band22" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="1600" height="140" as="geometry"/></mxCell><mxCell id="bandlbl23" value="INGEST" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="362.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b style='font-size:13px'&gt;Module 2 — Telemetry Collection &amp; Preprocessing&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/telemetry/{zmq_source.py, mock_source.py, preprocessing.py, schema.py}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;validate · impute/quarantine · unit-normalize · feature windows&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#2E5C8A;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="420.0" y="390.0" width="420" height="84" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b style='font-size:13px'&gt;Module 3 — Continuous Synchronization&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/synchronization/sync.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;background daemon thread — no manual sync step, ever&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#2E5C8A;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="900.0" y="390.0" width="420" height="84" as="geometry"/></mxCell><mxCell id="band26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9F2EC;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="1600" height="120" as="geometry"/></mxCell><mxCell id="bandlbl27" value="STATE" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="518.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b style='font-size:13px'&gt;D1 — Dynamic DT State Store&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/d1_model_store.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;current state · history · quarantine (Parquet, atomic writes)&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D9F2EC;strokeColor=#1E7A6C;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;boundedLbl=1;strokeWidth=2;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="640.0" y="546.0" width="460" height="84" as="geometry"/></mxCell><mxCell id="band29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F5DC;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="1600" height="260" as="geometry"/></mxCell><mxCell id="bandlbl30" value="PREDICT" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="734.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b style='font-size:12px'&gt;Module 5 — DT Functional Model / Dependency-Aware Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/{orchestrator.py, model_registry.py, base.py}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C9EAC0;strokeColor=#3A8A3D;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="590.0" y="688" width="560" height="48" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style='font-size:11px'&gt;Module 6 — Throughput&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/throughput.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;root · XGBoost&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F5DC;strokeColor=#3A8A3D;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="162.0" y="772" width="264" height="96" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b style='font-size:11px'&gt;Module 8 — Packet Loss&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/packet_loss.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;root · XGBoost&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F5DC;strokeColor=#3A8A3D;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="450.0" y="772" width="264" height="96" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b style='font-size:11px'&gt;Module 7 — Latency&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/latency.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;dep: throughput&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F5DC;strokeColor=#3A8A3D;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="738.0" y="772" width="264" height="96" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b style='font-size:11px'&gt;Module 9 — PRB Utilization&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/prb_utilization.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;dep: throughput (opt.)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F5DC;strokeColor=#3A8A3D;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="1026.0" y="772" width="264" height="96" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b style='font-size:11px'&gt;Module 10 — Jitter&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/jitter.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;dep: throughput, latency, packet_loss&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F5DC;strokeColor=#3A8A3D;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="1314.0" y="772" width="264" height="96" as="geometry"/></mxCell><mxCell id="band37" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF0D5;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1600" height="300" as="geometry"/></mxCell><mxCell id="bandlbl38" value="EVALUATE / TRIGGER" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="1040.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b style='font-size:12px'&gt;Module 12 — Fidelity Evaluation (per-component + unified)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/fidelity/{metrics.py, evaluator.py, trigger.py}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;FidelityScore_c = 1 − (ΣD̃_m)/4  ·  UnifiedScore = Σw_c·FidelityScore_c / Σw_c&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF0D5;strokeColor=#B8860B;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="550.0" y="974" width="640" height="92" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b style='font-size:13px'&gt;Module 11 — External Drift Detection Interface&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/drift/{drift_detector.py, mock_drift_source.py}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;trigger_type = &quot;external_drift&quot;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF0D5;strokeColor=#B8860B;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="370.0" y="1106" width="460" height="84" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b style='font-size:13px'&gt;Internal Fidelity-Based Trigger (debounced)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/fidelity/trigger.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;trigger_type = &quot;fidelity_degradation&quot;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF0D5;strokeColor=#B8860B;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="910.0" y="1106" width="460" height="84" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b style='font-size:11px'&gt;Canonical AdaptationTrigger Queue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;component · severity · trigger_type · timestamp&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEFD1;strokeColor=#B8860B;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="640.0" y="1230" width="460" height="52" as="geometry"/></mxCell><mxCell id="band43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="1600" height="220" as="geometry"/></mxCell><mxCell id="bandlbl44" value="DECIDE" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="1326.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b style='font-size:12px'&gt;Module 13 — Decision &amp; Root-Cause Analysis Agent&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT 1&lt;/span&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/adaptation/{decision_context.py, decision_agent.py}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;output: strategy · root_cause_analysis · confidence · rationale · knowledge_refs&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=#6A3FA0;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="590.0" y="1346.0" width="560" height="100" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b style='font-size:10.5px'&gt;D2 (Module 18) — RAG Knowledge Base&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/rag/rag_kb.py + rag_data/&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;read-only vector store (ChromaDB)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3EDFB;strokeColor=#6A3FA0;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="1354.0" width="260" height="84" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b style='font-size:10.5px'&gt;Google AI Client (Gemini)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/llm/google_client.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;centralized GoogleClient — no per-agent instances&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3EDFB;strokeColor=#6A3FA0;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="1370" y="1354.0" width="260" height="84" as="geometry"/></mxCell><mxCell id="band48" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="1532" width="1600" height="320" as="geometry"/></mxCell><mxCell id="bandlbl49" value="ADAPT" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="1622.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n50" value="strategy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3EDFB;strokeColor=#6A3FA0;fontFamily=Helvetica;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="785.0" y="1538" width="170" height="64" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b style='font-size:11.5px'&gt;Module 14 — Recalibration Agent&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT 2&lt;/span&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/adaptation/recalibration_agent.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;retrain existing class on a recent D1 window — no LLM required&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=#6A3FA0;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="140.0" y="1632" width="460" height="100" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b style='font-size:11.5px'&gt;Module 15 — Regeneration Agent&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT 3&lt;/span&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/adaptation/regeneration_agent.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;LLM rebuilds the component's pipeline from scratch&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=#6A3FA0;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="640.0" y="1632" width="460" height="100" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b style='font-size:11.5px'&gt;Module 16 — Expand-Scope Agent&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT 4&lt;/span&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/adaptation/expand_scope_agent.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;LLM designs + implements a genuinely NEW component&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=#6A3FA0;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140.0" y="1632" width="460" height="100" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b style='font-size:10.5px'&gt;Sandbox Execution Layer — isolated subprocess&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/sandbox/{executor.py, _sandbox_driver.py}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;syntax → import → conformance → train → evaluate — LLM code never runs in-process here&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECECEC;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="510.0" y="1766" width="720" height="70" as="geometry"/></mxCell><mxCell id="band55" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="1878" width="1600" height="240" as="geometry"/></mxCell><mxCell id="bandlbl56" value="VERIFY" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="1928.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b style='font-size:12px'&gt;Module 17 — Agentic Verification Agent&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT 5&lt;/span&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/adaptation/verification_agent.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;deterministic gate: FidelityScore_new &gt; FidelityScore_old + δ  (LLM may only explain)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B23A3A;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="560.0" y="1892" width="620" height="92" as="geometry"/></mxCell><mxCell id="n58" value="ACCEPT&lt;br&gt;/ REJECT" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#B23A3A;fontFamily=Helvetica;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="775.0" y="2020" width="190" height="70" as="geometry"/></mxCell><mxCell id="band59" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF5;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="2144" width="1600" height="170" as="geometry"/></mxCell><mxCell id="bandlbl60" value="PROMOTE" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="2159.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b style='font-size:11px'&gt;Versioned Model Registry (Concept C)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/registry/model_registry.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;promote() / reject() / rollback() — rollback-safe, one production version&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF5;strokeColor=#2C3E6B;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="380.0" y="2179.0" width="460" height="100" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b style='font-size:10.5px'&gt;Live DTModelRegistry + Hot Swap&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/dt_models/model_registry.py (.replace()) / src/main.py (_hot_swap_candidate)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;ACCEPTed candidate serves live — no process restart required&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF5;strokeColor=#2C3E6B;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=10.5;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="900.0" y="2179.0" width="460" height="100" as="geometry"/></mxCell><mxCell id="band63" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D8;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="2340" width="1600" height="140" as="geometry"/></mxCell><mxCell id="bandlbl64" value="RECORD" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3A3A3A;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="2340.0" width="140" height="24" as="geometry"/></mxCell><mxCell id="n65" value="&lt;b style='font-size:12px'&gt;Module 19 — Lifecycle Management Agent&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#B8860B;color:#FFFFFF;border-radius:8px;padding:1px 6px;font-size:9px;font-weight:bold;'&gt;AGENT 6&lt;/span&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9.5px;color:#3A3A3A'&gt;src/adaptation/lifecycle_agent.py → lifecycle_records.jsonl, maintenance_reports/*.md&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9.5px;color:#3A3A3A'&gt;&lt;i&gt;auditable append-only record + human-readable maintenance report, every cycle&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6D8;strokeColor=#A67C00;fontColor=#1A1A1A;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="560.0" y="2366.0" width="620" height="88" as="geometry"/></mxCell><mxCell id="t67" value="Fig. 1.  End-to-end architecture and continuous adaptation pipeline of the AI-driven self-adaptive network digital twin, showing all 19 modules, D1/D2, both trigger sources, the three LLM-driven adaptation strategies, and the deterministic verification / hot-swap promotion loop." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="2540" width="1600" height="30" as="geometry"/></mxCell><mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;fontFamily=Helvetica;fontSize=9.5;jettySize=auto;orthogonalLoop=1;dashed=1;" edge="1" parent="1" source="n21" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" value="ZeroMQ&lt;br&gt;PUB/SUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontFamily=Helvetica;fontSize=9.5;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e70" value="clean records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontFamily=Helvetica;fontSize=9.5;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="batched writes&lt;br&gt;(background thread)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontFamily=Helvetica;fontS