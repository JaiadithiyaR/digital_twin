# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
.venv/
venv/

# Secrets — .env holds the API key and machine-specific paths; .env.example is the template
.env
*.pem
*.key

# Editor / assistant / OS
.claude/
.vscode/
.idea/
.DS_Store
*.swp
*:Zone.Identifier

# ---------------------------------------------------------------------------------------------
# Data. COMMITTED: data/processed/oai/ (the processed OAI testbed tables everything runs on).
# NOT committed: the raw OAI CSV export (lives outside the repo, see OAI_ROOT in .env.example)
# and all runtime state, which every run rebuilds.
# ---------------------------------------------------------------------------------------------
data/raw/
/rankpi_kpi/
data/processed/*
!data/processed/oai/
data/bootstrap/*
data/telemetry/*
data/evaluation/*
data/artifacts/*
!data/bootstrap/.gitkeep
!data/telemetry/.gitkeep
!data/evaluation/.gitkeep
!data/artifacts/.gitkeep
data/models/
data/demo_recalibration/
data/demo_regeneration/
data/demo_expand_scope/
data/e2e_oai_smoke/
data/agent_tests/

# RAG vector store — rebuilt in seconds by `python scripts/ingest_rag.py`
rag_data/chroma/
rag_data/**/*.chroma

# Candidate sandbox workspaces
sandbox_workspaces/
/tmp_candidates/

# ---------------------------------------------------------------------------------------------
# Results. COMMITTED: baselines/results/ (events, timelines, stats, graphs, run logs, the model
# versions each run produced), figures/, reports/. NOT committed: each run's D1 replay copies
# (byte-for-byte replays of data/processed/oai/test.parquet) and the pre-2026-10-20 results,
# which used a leaky protocol and must not be cited.
# ---------------------------------------------------------------------------------------------
baselines/results/**/d1_*.parquet
baselines/results_archive_*/

# Logs of live runs (baseline run logs are kept under baselines/results/run_logs/)
*.log
logs/
!baselines/results/run_logs/*.log

# Retired NS-3/5G-LENA toolchain and its pre-migration runtime state (historical only)
archive/ns3_sim/ns-3-dev/
archive/ns3_sim/pre_oai_migration_data/

# Unpublished manuscript draft (predates the OAI migration)
docs/IEEE_Digital_Twin_Paper.docx
