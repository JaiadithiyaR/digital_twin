# Copy this file to .env and fill in real values. Never commit .env.

# Required for Regeneration Agent, Expand-Scope Agent, Verification Agent (LLM reasoning),
# and Lifecycle Agent (human-readable report generation).
ANTHROPIC_API_KEY=sk-ant-your-key-here

