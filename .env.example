# Copy this file to .env and fill in real values. Never commit .env.

# Required for the Decision & Root-Cause Analysis Agent (Module 13), Regeneration Agent,
# Expand-Scope Agent, Verification Agent (LLM reasoning), and Lifecycle Agent (human-readable
# report generation). GOOGLE_API_KEY takes precedence if both are set (matches google-genai's
# own SDK precedence) — set either one.
GOOGLE_API_KEY=your-google-ai-api-key-here
# GEMINI_API_KEY=your-google-ai-api-key-here

# Optional overrides (defaults live in config/settings.yaml; secrets never go in YAML)
# GOOGLE_MODEL=gemini-2.5-flash
